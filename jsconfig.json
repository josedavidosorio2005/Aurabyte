{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM"],
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "moduleResolution": "bundler"
  },
  "include": ["**/*.js"],
  "exclude": ["node_modules", ".venv", "playwright-report", "test-results"]
}
