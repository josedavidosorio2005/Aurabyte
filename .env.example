# Copia este archivo a .env y ajusta los valores. .env nunca se commitea (ver .gitignore).

# Modo debug de Flask: NUNCA en 1 en producción (expone el debugger de Werkzeug).
FLASK_DEBUG=0

# Host/puerto del servidor de desarrollo.
HOST=127.0.0.1
PORT=5000

# Clave usada para firmar sesiones/cookies. Genera una propia, p. ej.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Orígenes permitidos por CORS, separados por coma. Vacío = ningún origen cruzado permitido
# (correcto cuando el frontend se sirve desde esta misma app).
# Ejemplo si el frontend vive en otro dominio: ALLOWED_ORIGINS=https://aurabyte.com
ALLOWED_ORIGINS=

# Envío por SMTP del endpoint /api/contact. Aurabyte hoy NO tiene correo
# empresarial y el canal principal de contacto del sitio es WhatsApp (el
# formulario visible abre wa.me, no llama a este endpoint — ver CLAUDE.md,
# "Canal de contacto"). Este bloque queda disponible por si en el futuro se
# configura un correo real y se quiere reactivar el envío por email; sin
# estas 4 variables, /api/contact sigue funcionando (valida y registra) pero
# responde email_sent=false sin afirmar un envío que no ocurrió. Nunca
# commitees estos valores reales.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Buzón de Aurabyte que recibiría los mensajes, si se activa este canal.
CONTACT_EMAIL_TO=
